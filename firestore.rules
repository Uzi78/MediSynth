/**
 * @file Firestore Security Rules - RELAXED FOR DEVELOPMENT
 * @version 3
 *
 * @description These rules are relaxed for development purposes.
 * They allow authenticated users to read and write most data with minimal restrictions.
 * This is for rapid prototyping and iteration.
 *
 * Data Structure:
 * - /users/{userId}: User profiles. Access controlled by ownership.
 * - /users/{userId}/patients/{patientId}: Patient data. Access controlled by ownership.
 * - /users/{userId}/patients/{patientId}/records/{recordId}: Medical records. Access controlled by ownership.
 * - /doctors/{doctorId}: Doctor profiles (publicly readable). Writable by doctor (ownership on doctorId).
 * - /doctors/{doctorId}/patients/{patientId}: Doctor-patient relationships. Writable by doctor (ownership on doctorId).
 * - /consultations/{consultationId}: Consultation requests. Authenticated users have full access.
 *
 * Key Security Decisions:
 * - User listing is allowed for all collections during development for ease of debugging.
 * - Schema validation is skipped to allow for rapid data model changes.
 *
 * WARNING: Before deploying to production, tighten these rules to enforce
 * proper data ownership and access control.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================================
    // HELPER FUNCTIONS
    // ============================================================================

    /**
     * @description Checks if the user is signed in.
     * @return {bool} True if the user is authenticated, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user owns the resource, based on the provided userId.
     * @param {string} userId - The user ID to compare against the request's auth UID.
     * @return {bool} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is the existing owner of the resource.
     * @param {string} userId - The user ID to compare against the request's auth UID.
     * @return {bool} True if the user is the owner and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    // ============================================================================
    // RULES
    // ============================================================================

    /**
     * @description User profiles - Allow users to manage their own profiles.
     * @path /users/{userId}
     * @allow (read) Authenticated user can read any user profile.
     * @allow (write) Authenticated user can write own user profile.
     * @deny (write) Authenticated user can not write other user profile.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Patient data - Allow users to manage their own patient data.
     * @path /users/{userId}/patients/{patientId}
     * @allow (read) Authenticated user can read any patient data.
     * @allow (write) Authenticated user can write own patient data.
     * @deny (write) Authenticated user can not write other user patient data.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/patients/{patientId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn(); // <-- CHANGED FROM isOwner(userId)
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Medical records - Allow users to manage their own records.
     * @path /users/{userId}/patients/{patientId}/records/{recordId}
     * @allow (read) Authenticated user can read any record data.
     * @allow (write) Authenticated user can write own record data.
     * @deny (write) Authenticated user can not write other user record data.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/patients/{patientId}/records/{recordId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn(); // <-- CHANGED FROM isOwner(userId)
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Doctor profiles - Publicly readable, writable by owner.
     * @path /doctors/{doctorId}
     * @allow (read) Anyone can read doctor profiles.
     * @allow (write) Authenticated doctor can write own profile.
     * @deny (write) Authenticated doctor can not write other doctor profile.
     * @principle Enforces document ownership for writes, public read access.
     */
    match /doctors/{doctorId} {
      allow get: if true;
      allow list: if true;
      allow create: if isOwner(doctorId);
      allow update: if isExistingOwner(doctorId);
      allow delete: if isExistingOwner(doctorId);
    }

    /**
     * @description Doctor-patient relationships - Relaxed access.
     * @path /doctors/{doctorId}/patients/{patientId}
     * @allow (read) Authenticated user can read the relation.
     * @allow (create) Authenticated user can create a relation.
     * @deny (update) Only the doctor can update the relation.
     * @deny (delete) Only the doctor can delete the relation.
     * @principle Doctor can create/update/delete patient relationships
     */
    match /doctors/{doctorId}/patients/{patientId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isExistingOwner(doctorId);
      allow delete: if isExistingOwner(doctorId);
    }

    /**
     * @description Consultations - Allow authenticated users full access.
     * @path /consultations/{consultationId}
     * @allow (read) Authenticated user can read consultations.
     * @allow (write) Authenticated user can write consultations.
     * @principle Authenticated users have full access, VERY PERMISSIVE - TIGHTEN THIS IN PRODUCTION.
     */
    match /consultations/{consultationId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
  }
}