/**
 * @file Firebase Security Rules
 * @version 2
 *
 * @description This ruleset enforces a strict user-ownership model for user profiles and patient data.
 * Doctors have read access to limited patient information and can manage consultations.
 *
 * Data Structure:
 * - /users/{userId}: User profile information.
 * - /users/{userId}/patients/{patientId}: Full patient records, accessible only by the patient.
 * - /users/{userId}/patients/{patientId}/records/{recordId}: Medical records for a patient.
 * - /doctors/{doctorId}: Public profile information for doctors.
 * - /doctors/{doctorId}/patients/{patientId}: Summary patient information for doctors.
 * - /consultations/{consultationId}: Consultation requests and their status.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data.
 * - Patients can only read and write their own patient data and records.
 * - Doctors can read doctor profile, create, update and delete their own summary patient data.
 * - Consultations are accessible to both the patient and the assigned doctor, with status-based access controls.
 * - User listing is disabled for privacy.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Protects user profile data, allowing only the owner to read and write.
     * @path /users/{userId}
     * @allow (get, update, delete) User with UID 'userId' can access their own profile.
     * @allow (create) User with UID 'userId' can create their own profile.
     * @deny (get, update, delete) User with UID 'anotherUserId' cannot access user 'userId' profile.
     * @principle Enforces document ownership for profile management.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // User listing is not permitted.
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Protects patient data, allowing only the patient to read and write.
     * @path /users/{userId}/patients/{patientId}
     * @allow (get, update, delete) User with UID 'userId' can access their own patient data.
     * @allow (create) User with UID 'userId' can create their own patient data.
     * @deny (get, update, delete) User with UID 'anotherUserId' cannot access user 'userId' patient data.
     * @principle Enforces document ownership for patient data.
     */
    match /users/{userId}/patients/{patientId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Protects medical records, allowing only the patient to read and write.
     * @path /users/{userId}/patients/{patientId}/records/{recordId}
     * @allow (get, update, delete) User with UID 'userId' can access their own medical records.
     * @allow (create) User with UID 'userId' can create their own medical records.
     * @deny (get, update, delete) User with UID 'anotherUserId' cannot access user 'userId' medical records.
     * @principle Enforces document ownership for medical records.
     */
    match /users/{userId}/patients/{patientId}/records/{recordId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows anyone to read doctor profiles.  Doctors can modify their own profiles.
     * @path /doctors/{doctorId}
     * @allow (get, list) Anyone can view doctor profiles.
     * @allow (create, update, delete) Doctors can only modify their own profile.
     * @deny (create, update, delete) Other users cannot modify a doctor's profile.
     * @principle Allows public read access for doctor discovery while restricting write access to the doctor.
     */
    match /doctors/{doctorId} {
      allow get, list: if true;
      allow create: if isOwner(doctorId);
      allow update: if isOwner(doctorId);
      allow delete: if isExistingOwner(doctorId);
    }

    /**
     * @description Allows doctors to read/write patient summary for their assigned patients.
     * @path /doctors/{doctorId}/patients/{patientId}
     * @allow (get, list) Doctor with doctorId can view their assigned patients.
     * @allow (create, update, delete) Doctor with doctorId can create, update, delete their assigned patients.
     * @deny (get, update, delete) Other doctors cannot access the patients of doctorId.
     * @principle Restricts access to doctor-patient relationships.
     */
    match /doctors/{doctorId}/patients/{patientId} {
      allow get: if isOwner(doctorId);
      allow list: if isOwner(doctorId);
      allow create: if isOwner(doctorId);
      allow update: if isOwner(doctorId);
      allow delete: if isExistingOwner(doctorId);
    }

    /**
     * @description Controls access to consultations.
     * @path /consultations/{consultationId}
     * @allow (get) Patient or doctor can read consultation details.
     * @allow (create) Any signed-in user can request a consultation.
     * @allow (update) Only the doctor assigned to the consultation can update its status.
     * @deny (delete) No one can delete consultations.
     * @principle Manages the consultation lifecycle with role-based access.
     */
    match /consultations/{consultationId} {
      allow get: if get(/databases/$(database)/documents/consultations/$(consultationId)).data.patientId == request.auth.uid ||
                     get(/databases/$(database)/documents/consultations/$(consultationId)).data.doctorId == request.auth.uid;
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if get(/databases/$(database)/documents/consultations/$(consultationId)).data.doctorId == request.auth.uid;
      allow delete: if false;
    }

    /**
     * @description Helper function to determine if the request is from the owner of the resource.
     * @param {string} userId The user ID to compare against the request's authentication UID.
     * @returns {boolean} True if the request is from the owner, false otherwise.
     */
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    /**
     * @description Helper function to determine if the request is from the owner of the resource and the resource exists.
     * @param {string} userId The user ID to compare against the request's authentication UID.
     * @returns {boolean} True if the request is from the owner and resource exist, false otherwise.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    /**
     * @description Helper function to determine if a user is signed in.
     * @returns {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }
  }
}