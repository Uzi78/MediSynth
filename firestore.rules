/**
 * @fileoverview Firestore Security Rules for Prototyping.
 *
 * Core Philosophy:
 * This ruleset prioritizes secure authorization while permitting flexible data shapes
 * to enable rapid prototyping. It uses a strict ownership model for user-specific data
 * and carefully controls access to shared resources. Schema validation is relaxed to
 * facilitate quick iteration, focusing instead on verifying relationships between
 * documents.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles. Only the authenticated user can read/write their own profile.
 * - /users/{userId}/patients/{patientId}: Stores patient data; only the owning user can access.
 * - /users/{userId}/patients/{patientId}/records/{recordId}: Stores medical records, accessible only by the owning user.
 * - /doctors/{doctorId}: Stores public doctor profiles, readable by anyone, but only writable by the doctor themselves.
 * - /doctors/{doctorId}/patients/{patientId}: Stores doctor-patient relationships, writable only by the doctor.
 * - /consultations/{consultationId}: Stores consultation requests; allows listing by anyone, but creation only by the patient.
 *
 * Key Security Decisions:
 * - User listing is explicitly denied for privacy.
 * - Data validation focuses on ownership and relational integrity, not comprehensive schema checks.
 * - Doctor profiles are publicly readable to facilitate discovery.
 *
 * Denormalization for Authorization:
 * To avoid `get()` calls in rules, the following denormalization strategies are used:
 *   - User ownership is verified by matching the `userId` path segment with the `request.auth.uid`.
 *   - No external membership collections are used; shared access is based on internal user ID lists or maps within the document.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (create) If the user's ID matches the document ID; creates a new profile.
     * @allow (get, update, delete) If the user's ID matches the document ID; views, modifies, or deletes their own profile.
     * @deny (list) User profiles should not be listable.
     * @deny (create, update, delete) If the user's ID does not match the document ID.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Controls access to patient documents within a user's profile.
     * @path /users/{userId}/patients/{patientId}
     * @allow (create) If the user's ID matches the parent user document ID; creates a new patient record.
     * @allow (get, update, delete) If the user's ID matches the parent user document ID; views, modifies, or deletes their own patient record.
     * @allow (list) If the user's ID matches the parent user document ID; lists their own patient records.
     * @deny (create, update, delete) If the user's ID does not match the parent user document ID.
     * @principle Enforces document ownership for patient records.
     */
    match /users/{userId}/patients/{patientId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Controls access to medical record documents within a patient's profile.
     * @path /users/{userId}/patients/{patientId}/records/{recordId}
     * @allow (create) If the user's ID matches the grandparent user document ID; creates a new medical record.
     * @allow (get, update, delete) If the user's ID matches the grandparent user document ID; views, modifies, or deletes their own medical record.
     * @allow (list) If the user's ID matches the grandparent user document ID; lists their own medical records.
     * @deny (create, update, delete) If the user's ID does not match the grandparent user document ID.
     * @principle Enforces document ownership for medical records.
     */
    match /users/{userId}/patients/{patientId}/records/{recordId} {
       function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Controls access to doctor profile documents.
     * @path /doctors/{doctorId}
     * @allow (get, list) Anyone can read or list doctor profiles.
     * @allow (create) If the doctor's ID matches the document ID; creates their own profile.
     * @allow (update, delete) If the doctor's ID matches the document ID and the document exists; modifies or deletes their own profile.
     * @deny (create, update, delete) If the doctor's ID does not match the document ID.
     * @principle Allows public read access to doctor profiles while enforcing ownership for writes.
     */
    match /doctors/{doctorId} {
       function isOwner(doctorId) {
        return request.auth.uid == doctorId;
      }
      function isExistingOwner(doctorId) {
          return isOwner(doctorId) && resource != null;
      }
      function isSignedIn() {
        return request.auth != null;
      }
      allow get, list: if true;
      allow create: if isOwner(doctorId);
      allow update: if isExistingOwner(doctorId);
      allow delete: if isExistingOwner(doctorId);
    }

    /**
     * @description Controls access to doctor-patient relationship documents.
     * @path /doctors/{doctorId}/patients/{patientId}
     * @allow (create, update, delete) If the doctor's ID matches the parent doctor document ID and the document exists; creates, modifies, or deletes a patient relationship.
     * @deny (get, list) Patients cannot list the doctors assigned to them.
     * @deny (create, update, delete) If the doctor's ID does not match the parent doctor document ID.
     * @principle Restricts doctor-patient relationship management to the doctor.
     */
    match /doctors/{doctorId}/patients/{patientId} {
      function isOwner(doctorId) {
        return request.auth.uid == doctorId;
      }
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if false;
      allow list: if false;
      allow create: if isOwner(doctorId);
      allow update: if isOwner(doctorId);
      allow delete: if isOwner(doctorId);
    }

     /**
      * @description Controls access to consultation documents.
      * @path /consultations/{consultationId}
      * @allow (get, list) Anyone can read consultations.
      * @allow (create) If the consultation's `patientId` matches the authenticated user's ID.
      * @allow (update, delete) if false
      * @principle Allows public read access to consultations and restricts write access to the owning patient.
      */
    match /consultations/{consultationId} {
        function isSignedIn() {
            return request.auth != null;
        }

        allow get, list: if true; //allowing all users to list and get consultations

        allow create: if isSignedIn() && request.resource.data.patientId == request.auth.uid;
        allow update: if false;
        allow delete: if false;
    }
  }
}