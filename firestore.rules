/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based and ownership-based access control model.
 * Users are divided into 'patient' and 'doctor' roles. Doctors can only manage
 * patients explicitly associated with them. Patients have full access to their
 * own data.  Public doctor profiles are readable by everyone.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles (role).
 * - /users/{userId}/patients/{patientId}: Stores patient data (patient-owned).
 * - /users/{userId}/patients/{patientId}/records/{recordId}: Stores patient records (patient-owned).
 * - /doctors/{doctorId}: Stores public doctor profiles (public read, owner write).
 * - /doctors/{doctorId}/patients/{patientId}: Stores doctor-patient assignments (doctor-owned).
 * - /consultations/{consultationId}: Stores consultation requests (open create, doctor/patient access).
 *
 * Key Security Decisions:
 * - Users can only create their own profile.
 * - Patients have full control over their own data (patients and records).
 * - Doctor profiles are publicly readable, but only doctors can modify their own profiles.
 * - Doctors can only manage patients assigned to them.
 * - Consultations can be created by anyone, but only the involved doctor and patient can access them.
 * - Listing of doctor's patients is only allowed for the doctor.
 *
 * Denormalization for Authorization:
 *  - Doctor-patient relationships are explicitly modeled in the /doctors/{doctorId}/patients/{patientId}
 *    collection. This avoids the need for complex queries or joins in security rules.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure user profiles. Users can only read/write their own profile.
     * @path /users/{userId}
     * @allow (create) - A user can create their own profile.
     * @allow (get, update, delete) - A user can read, update, and delete their own profile.
     * @deny (create) - A user cannot create another user's profile.
     * @deny (get, update, delete) - A user cannot read, update, or delete another user's profile.
     * @principle Enforces user ownership for profile data.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Secure patient data under a user's profile. Patients can only manage their own data.
     * @path /users/{userId}/patients/{patientId}
     * @allow (create, get, update, delete) - A user can manage their own patient data.
     * @deny (create, get, update, delete) - A user cannot manage another user's patient data.
     * @principle Enforces user ownership for patient data.
     */
    match /users/{userId}/patients/{patientId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == patientId;
      allow update: if isOwner(userId) && resource.data.id == patientId;
      allow delete: if isOwner(userId);
    }

    /**
     * @description Secure medical records under a patient's profile. Patients can only manage their own records.
     * @path /users/{userId}/patients/{patientId}/records/{recordId}
     * @allow (create, get, update, delete) - A user can manage their own medical records.
     * @deny (create, get, update, delete) - A user cannot manage another user's medical records.
     * @principle Enforces user ownership for medical record data.
     */
    match /users/{userId}/patients/{patientId}/records/{recordId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.patientId == patientId;
      allow update: if isOwner(userId) && resource.data.patientId == patientId;
      allow delete: if isOwner(userId);
    }

    /**
     * @description Doctor profiles are publicly readable but only the doctor can modify.
     * @path /doctors/{doctorId}
     * @allow (get, list) - Anyone can read the doctor profile.
     * @allow (create, update, delete) - Only the doctor can create, update, or delete their profile.
     * @principle Public read access with owner-only writes.
     */
    match /doctors/{doctorId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(doctorId) {
        return request.auth.uid == doctorId;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isOwner(doctorId);
      allow update: if isOwner(doctorId);
      allow delete: if isOwner(doctorId);
    }

    /**
     * @description Doctor-patient assignments. Only the doctor can manage their assigned patients.
     * @path /doctors/{doctorId}/patients/{patientId}
     * @allow (create, get, update, delete) - Only the doctor can manage their assigned patients.
     * @deny (create, get, update, delete) - Others cannot manage doctor's patients.
     * @principle Enforces doctor ownership for patient assignments.
     */
    match /doctors/{doctorId}/patients/{patientId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(doctorId) {
        return request.auth.uid == doctorId;
      }

       allow get: if isOwner(doctorId);
       //Fixed: The error reported was a list operation denied due to insufficient permissions
       //       We are allowing the doctor to list the patients from the rule.
       allow list: if isOwner(doctorId);
       allow create: if isOwner(doctorId) && request.resource.data.patientId == patientId;
       allow update: if isOwner(doctorId) && request.resource.data.patientId == patientId;
       allow delete: if isOwner(doctorId);
    }

    /**
     * @description Consultations can be created by anyone, but access is limited to involved parties.
     * @path /consultations/{consultationId}
     * @allow (create) - Anyone can create a consultation request.
     * @allow (get, update, delete) - Only the involved doctor or patient can access the consultation.
     * @principle Open create, shared access for existing consultations.
     */
    match /consultations/{consultationId} {
        function isSignedIn() {
            return request.auth != null;
        }

        function isParticipant(doctorId, patientId) {
            return isSignedIn() && (request.auth.uid == doctorId || request.auth.uid == patientId);
        }

        allow get: if isParticipant(resource.data.doctorId, resource.data.patientId);
        allow list: if false;
        allow create: if isSignedIn();
        allow update: if isParticipant(resource.data.doctorId, resource.data.patientId);
        allow delete: if false; // Consultations should not be deleted.
    }
  }
}