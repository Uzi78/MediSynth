/**
 * @fileoverview Firestore Security Rules for Prototyping.
 *
 * Core Philosophy:
 * This ruleset prioritizes strict authorization based on user roles and
 * ownership, but relaxes data validation to enable rapid prototyping.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles with roles ('patient', 'doctor').
 * - /users/{userId}/patients/{patientId}: Stores patient-specific data; accessible only by the owning user.
 * - /users/{userId}/patients/{patientId}/records/{recordId}: Stores medical records, also only accessible by the owning user.
 * - /doctors/{doctorId}: Stores public-facing doctor profiles. Accessible by all users.
 * - /doctors/{doctorId}/patients/{patientId}: Stores doctor-patient summary for fast list views. Accessible only by the doctor.
 * - /consultations/{consultationId}: Stores consultation requests.
 *
 * Key Security Decisions:
 * - Users can only read and write their own patients and records.
 * - Doctor profiles are publicly readable but only writable by authenticated users (no specific role check).
 * - Listing all users is disallowed for privacy.
 *
 * Denormalization for Authorization:
 * - DoctorPatient documents are created under the doctor's path. This is already denormalized.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the current user is signed in.
     * @returns {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the current user is the owner of the resource.
     * @param {string} userId The user ID to compare against the request's authentication UID.
     * @returns {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
        return request.auth.uid == userId;
    }

    /**
     * @description Checks if the current user is the owner of the resource and that the document exists.
     * @param {string} userId The user ID to compare against the request's authentication UID.
     * @returns {boolean} True if the user is the owner and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    /**
     * @description Rules for the /users/{userId} collection.
     * @path /users/{userId}
     * @allow (create) User with UID 'user123' can create their own profile.
     * @allow (get) User with UID 'user123' can read their own profile.
     * @allow (update) User with UID 'user123' can update their own profile.
     * @deny (create) User with UID 'user456' cannot create a profile for 'user123'.
     * @deny (list) No one can list all users.
     * @principle Enforces user-ownership for profile data.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if false;
    }

    /**
     * @description Rules for the /users/{userId}/patients/{patientId} collection.
     * @path /users/{userId}/patients/{patientId}
     * @allow (create) User with UID 'user123' can create a patient document under their profile.
     * @allow (get) User with UID 'user123' can read a patient document under their profile.
     * @allow (update) User with UID 'user123' can update a patient document under their profile.
     * @deny (create) User with UID 'user456' cannot create a patient document for 'user123'.
     * @principle Enforces user-ownership for patient data.
     */
    match /users/{userId}/patients/{patientId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for the /users/{userId}/patients/{patientId}/records/{recordId} collection.
     * @path /users/{userId}/patients/{patientId}/records/{recordId}
     * @allow (create) User with UID 'user123' can create a record document under their patient.
     * @allow (get) User with UID 'user123' can read a record document under their patient.
     * @allow (update) User with UID 'user123' can update a record document under their patient.
     * @deny (create) User with UID 'user456' cannot create a record document for 'user123'.
     * @principle Enforces user-ownership for medical record data.
     */
    match /users/{userId}/patients/{patientId}/records/{recordId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

        /**
     * @description Rules for the /doctors/{doctorId} collection.
     * @path /doctors/{doctorId}
     * @allow (get) Any user can read doctor profiles.
     * @allow (list) Any user can list doctor profiles.
     * @allow (create) Authenticated users can create doctor profiles (no specific role check).
     * @allow (update) Authenticated users can update doctor profiles (no specific role check).
     * @deny (create) Unauthenticated users cannot create doctor profiles.
     * @principle Allows public read access to doctor profiles, restricts write access to authenticated users.
     */
    match /doctors/{doctorId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if false;
    }

    /**
     * @description Rules for the /doctors/{doctorId}/patients/{patientId} collection.
     * @path /doctors/{doctorId}/patients/{patientId}
     * @allow (create) A doctor can create a patient summary under their profile.
     * @allow (get) A doctor can read a patient summary under their profile.
     * @allow (list) A doctor can list patient summaries under their profile.
     * @deny (create) A patient cannot create a doctor's patient summary.
     * @principle Enforces doctor-ownership for doctor-patient summary data.
     */
    match /doctors/{doctorId}/patients/{patientId} {
      allow get: if isOwner(doctorId);
      allow list: if isOwner(doctorId);
      allow create: if isOwner(doctorId);
      allow update: if isExistingOwner(doctorId);
      allow delete: if isExistingOwner(doctorId);
    }

      /**
       * @description Rules for the /consultations/{consultationId} collection.
       * @path /consultations/{consultationId}
       * @allow (get) Any user can read consultation requests.
       * @allow (list) Any user can list consultation requests.
       * @allow (create) Authenticated users can create consultation requests.
       * @allow (update) Authenticated users can update consultation requests.
       * @deny (create) Unauthenticated users cannot create consultation requests.
       */
    match /consultations/{consultationId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if false;
    }
  }
}