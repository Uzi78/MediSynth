/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control model,
 * allowing fine-grained control over data access based on user roles (patient, doctor)
 * and resource ownership.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information (role).
 * - /users/{userId}/patients/{patientId}: Stores patient data, accessible only by the patient.
 * - /users/{userId}/patients/{patientId}/records/{recordId}: Stores medical records, accessible only by the patient.
 * - /doctors/{doctorId}: Stores doctor profile information, publicly readable, writable by the doctor.
 * - /doctors/{doctorId}/patients/{patientId}: Stores doctor-patient relationship summaries, accessible only by the doctor.
 * - /consultations/{consultationId}: Stores consultation requests, accessible by any signed-in user.
 * - /consultations/{consultationId}/messages/{messageId}: Stores chat messages for a consultation, accessible by any signed-in user.
 *
 * Key Security Decisions:
 * - User listing is disallowed.
 * - Doctor profiles are publicly readable.
 * - Patients can only access their own data.
 * - Doctors can only access summaries of their patients.
 * - Any signed-in user can create consultations and messages.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages user profile data.
     * @path /users/{userId}
     * @allow (get) User with ID 'user123' can get their own profile.
     * @allow (create) User with ID 'user123' can create their own profile.
     * @allow (update) User with ID 'user123' can update their own profile.
     * @deny (list) No one can list users.
     * @deny (delete) No one can delete users.
     * @principle Enforces document ownership; users can only manage their own profile.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if false;
    }

    /**
     * @description Manages patient data for a specific user.
     * @path /users/{userId}/patients/{patientId}
     * @allow (get) User with ID 'user123' can get their patient data.
     * @allow (list) User with ID 'user123' can list their patients.
     * @allow (create) User with ID 'user123' can create patient data.
     * @allow (update) User with ID 'user123' can update patient data.
     * @allow (delete) User with ID 'user123' can delete patient data.
     * @deny (get) User with ID 'otherUser' cannot get patient data of 'user123'.
     * @principle Restricts patient data access to the owning user.
     */
    match /users/{userId}/patients/{patientId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages medical records for a specific patient.
     * @path /users/{userId}/patients/{patientId}/records/{recordId}
     * @allow (get) User with ID 'user123' can get medical records.
     * @allow (list) User with ID 'user123' can list medical records.
     * @allow (create) User with ID 'user123' can create medical records.
     * @allow (update) User with ID 'user123' can update medical records.
     * @allow (delete) User with ID 'user123' can delete medical records.
     * @deny (get) User with ID 'otherUser' cannot get medical records of 'user123'.
     * @principle Restricts record data access to the owning user.
     */
    match /users/{userId}/patients/{patientId}/records/{recordId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages doctor profile data.
     * @path /doctors/{doctorId}
     * @allow (get) Any user can get a doctor's profile.
     * @allow (create) Doctor with ID 'doctor123' can create their own profile.
     * @allow (update) Doctor with ID 'doctor123' can update their own profile.
     * @deny (list) No one can list doctors.
     * @deny (delete) No one can delete doctors.
     * @principle Enforces document ownership for writes, allows public reads.
     */
    match /doctors/{doctorId} {
      allow get: if true;
      allow list: if false;
      allow create: if isOwner(doctorId) && request.resource.data.id == doctorId;
      allow update: if isExistingOwner(doctorId) && request.resource.data.id == resource.data.id;
      allow delete: if false;
    }

    /**
     * @description Manages doctor-patient relationship summaries.
     * @path /doctors/{doctorId}/patients/{patientId}
     * @allow (get) Doctor with ID 'doctor123' can get patient summaries.
     * @allow (list) Doctor with ID 'doctor123' can list patient summaries.
     * @allow (create) Doctor with ID 'doctor123' can create patient summaries.
     * @allow (update) Doctor with ID 'doctor123' can update patient summaries.
     * @allow (delete) Doctor with ID 'doctor123' can delete patient summaries.
     * @deny (get) Doctor with ID 'otherDoctor' cannot get patient summaries of 'doctor123'.
     * @principle Restricts access to doctor-patient relationship summaries to the owning doctor.
     */
    match /doctors/{doctorId}/patients/{patientId} {
      allow get: if isOwner(doctorId);
      allow list: if isOwner(doctorId);
      allow create: if isOwner(doctorId);
      allow update: if isExistingOwner(doctorId);
      allow delete: if isExistingOwner(doctorId);
    }

    /**
     * @description Manages consultation requests.
     * @path /consultations/{consultationId}
     * @allow (get) Any signed-in user can get a consultation.
     * @allow (list) Any signed-in user can list consultations.
     * @allow (create) Any signed-in user can create a consultation.
     * @allow (update) Any signed-in user can update a consultation.
     * @deny (delete) No one can delete a consultation.
     * @principle Allows anyone to create consultation requests, but restricts modification to owners.
     */
    match /consultations/{consultationId} {
        allow get: if isSignedIn();
        allow list: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isSignedIn();
        allow delete: if false;

        /**
         * @description Manages messages within a consultation.
         * @path /consultations/{consultationId}/messages/{messageId}
         * @allow (get) Any signed-in user can get a message within a consultation.
         * @allow (list) Any signed-in user can list messages within a consultation.
         * @allow (create) Any signed-in user can create a message within a consultation.
         * @allow (update) Any signed-in user can update a message within a consultation.
         * @deny (delete) No one can delete a message within a consultation.
         * @principle Allows signed-in users to read and create messages.
         */
        match /messages/{messageId} {
          allow get: if isSignedIn();
          allow list: if isSignedIn();
          allow create: if isSignedIn();
          allow update: if isSignedIn();
          allow delete: if false;
        }
    }
    match /consultations/{consultationId}/messages/{messageId} {
          allow get: if isSignedIn();
          allow list: if isSignedIn();
          allow create: if isSignedIn();
          allow update: if isSignedIn();
          allow delete: if false;
        }
  }

  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

  function isExistingOwner(userId) {
    return isOwner(userId) && resource != null;
  }
}