/**
 * @fileoverview Firestore Security Rules for Prototyping.
 *
 * Core Philosophy:
 * This ruleset prioritizes strict authorization based on user roles and
 * relationships, while providing flexible data validation to enable rapid
 * prototyping. It enforces ownership and role-based access control.
 *
 * Data Structure:
 * - /users/{userId}: User profiles, accessible only by the user themselves.
 * - /users/{userId}/patients/{patientId}: Patient data, accessible only by the user themselves.
 * - /users/{userId}/patients/{patientId}/records/{recordId}: Medical records for a patient, accessible only by the user themselves.
 * - /doctors/{doctorId}: Public doctor profiles, publicly readable.
 * - /doctors/{doctorId}/patients/{patientId}: Summary of patients assigned to doctor. Used for list views, only accessible by the doctor themselves.
 * - /consultations/{consultationId}: Consultation requests and status, accessible for reading by both doctor and patient. Can only be created by the patient.
 *
 * Key Security Decisions:
 * - Users can only access their own profile and associated patient data.
 * - Doctor profiles are publicly readable, but only doctors can update them.
 * - Listing users is disallowed for privacy.
 * - Role-based access control for administrative functions is not implemented in this prototype.
 *
 * Denormalization for Authorization:
 * - The consultation objects contain both `patientId` and `doctorId` so rules can be applied to both parties without extra reads.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile information.
     * @path /users/{userId}
     * @allow (get) Authenticated user can read their own profile.
     * @allow (create) Authenticated user can create their own profile.
     * @allow (update) Authenticated user can update their own profile.
     * @allow (delete) Authenticated user can delete their own profile.
     * @deny (get) Authenticated user cannot read another user's profile.
     * @principle Enforces user-ownership for accessing user profile data.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Controls access to patient data for a specific user.
     * @path /users/{userId}/patients/{patientId}
     * @allow (get) Authenticated user can read their own patient data.
     * @allow (create) Authenticated user can create patient data under their user ID.
     * @allow (update) Authenticated user can update patient data under their user ID.
     * @allow (delete) Authenticated user can delete patient data under their user ID.
     * @deny (get) Authenticated user cannot read another user's patient data.
     * @principle Enforces user-ownership for accessing patient data.
     */
    match /users/{userId}/patients/{patientId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
       function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
       }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to medical records for a specific patient.
     * @path /users/{userId}/patients/{patientId}/records/{recordId}
     * @allow (get) Authenticated user can read their own medical records.
     * @allow (create) Authenticated user can create medical records under their user ID and patient ID.
     * @allow (update) Authenticated user can update medical records under their user ID and patient ID.
     * @allow (delete) Authenticated user can delete medical records under their user ID and patient ID.
     * @deny (get) Authenticated user cannot read another user's medical records.
     * @principle Enforces user-ownership for accessing medical record data.
     */
    match /users/{userId}/patients/{patientId}/records/{recordId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
       }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
   /**
     * @description Controls access to doctor profiles. Doctors can update own profile, anyone can read.
     * @path /doctors/{doctorId}
     * @allow (get) Any user can read doctor profiles.
     * @allow (create) Authenticated user can create a doctor profile if they are the doctor.
     * @allow (update) Authenticated user can update their own doctor profile.
     * @deny (create) Non-authenticated user cannot create a doctor profile.
     * @principle Allows public read access to doctor profiles, but restricts write access to the doctor themselves.
     */
    match /doctors/{doctorId} {
      function isOwner(doctorId) {
        return request.auth != null && request.auth.uid == doctorId;
      }
       function isExistingOwner(doctorId) {
          return isOwner(doctorId) && resource != null;
       }
      allow get: if true;
      allow list: if false;
      allow create: if isOwner(doctorId);
      allow update: if isExistingOwner(doctorId);
      allow delete: if isExistingOwner(doctorId);
    }

    /**
     * @description Controls access to the list of patients assigned to a doctor (summary data).
     * @path /doctors/{doctorId}/patients/{patientId}
     * @allow (get) Authenticated doctor can read their own patient list.
     * @allow (create) Doctor can create patient data under their doctor ID.
     * @allow (update) Doctor can update patient data under their doctor ID.
     * @allow (delete) Doctor can delete patient data under their doctor ID.
     * @deny (get) Authenticated user cannot read another doctor's patient list.
     * @principle Enforces ownership: doctors can only manage their own patient lists.
     */
    match /doctors/{doctorId}/patients/{patientId} {
      function isOwner(doctorId) {
        return request.auth != null && request.auth.uid == doctorId;
      }
      function isExistingOwner(doctorId) {
          return isOwner(doctorId) && resource != null;
       }
      allow get: if isOwner(doctorId);
      allow list: if isOwner(doctorId);
      allow create: if isOwner(doctorId);
      allow update: if isExistingOwner(doctorId);
      allow delete: if isExistingOwner(doctorId);
    }

      /**
       * @description Controls access to consultation requests.
       * @path /consultations/{consultationId}
       * @allow (get) Patient or doctor can read a specific consultation.
       * @allow (create) Patient can create a consultation.
       * @deny (update) Only the backend can update a consultation (for status transitions).
       * @deny (delete) No one can delete a consultation.
       * @principle Shared Access with Owner-Only Create, Backend-Only Updates.
       */
      match /consultations/{consultationId} {
        function isPatientOrDoctor(patientId, doctorId) {
          return request.auth != null && (request.auth.uid == patientId || request.auth.uid == doctorId);
        }

        allow get: if isPatientOrDoctor(resource.data.patientId, resource.data.doctorId);
        allow list: if false;
        allow create: if request.auth != null && request.auth.uid == request.resource.data.patientId;
        allow update: if false; // TODO: add a backend check for consultation status transitions
        allow delete: if false;
      }
  }
}