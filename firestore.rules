/**
 * @fileoverview Firestore Security Rules for the Doctor-Patient Consultation App.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for profile data and patient records.
 * Doctors have read access to a limited patient summary within their collection.
 * Consultations can be listed, created and updated by authenticated users.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information (role).
 * - /users/{userId}/patients/{patientId}: Stores full patient records, accessible only by the patient.
 * - /users/{userId}/patients/{patientId}/records/{recordId}: Stores individual medical records for a patient, accessible only by the patient.
 * - /doctors/{doctorId}/patients/{patientId}: Stores doctor-patient relationships with summary patient data (for doctor's list views).
 * - /consultations/{consultationId}: Stores consultation requests.
 *
 * Key Security Decisions:
 * - Users can only access their own profile data.
 * - Patients can only access their own medical records.
 * - Doctors have read-only access to a summary of their assigned patients.
 * - Listing user documents is disallowed.
 *
 * Denormalization for Authorization:
 * - DoctorPatient documents are created in the /doctors/{doctorId}/patients/{patientId} collection,
 *   summarizing information from both the Patient and Doctor entities. This allows doctors to quickly
 *   access a list of their patients without querying the entire /users/{userId}/patients/{patientId} collection.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the requesting user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the requesting user owns the document at the matched path.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the requesting user is the existing owner of the document at the matched path.
     * @principle Ensures existence before modification or deletion.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }


    /**
     * @description Rules for user profiles.
     * @path /users/{userId}
     * @allow (create) - If the user's ID matches the requested userId
     * @allow (get, update, delete) - If the user is the owner of the profile.
     * @deny (list) - Listing all users is not allowed.
     * @deny (create) - If the user's ID does not match the requested userId
     * @principle Enforces document ownership for profile data.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for patient records stored under a user's profile.
     * @path /users/{userId}/patients/{patientId}
     * @allow (get, list, create, update, delete) - If the user is the owner (patient).
     * @deny (create) - If the patientId does not match request.auth.uid.
     * @deny (update) - If the patientId does not match the existing record's patientId
     * @principle Enforces document ownership for patient records.
     */
    match /users/{userId}/patients/{patientId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == patientId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for medical records associated with a patient.
     * @path /users/{userId}/patients/{patientId}/records/{recordId}
     * @allow (get, list, create, update, delete) - If the user is the owner (patient).
     * @deny (create) - If the patientId does not match the parent document's patientId.
     * @deny (update) - If the patientId does not match the parent document's patientId.
     * @principle Enforces document ownership for medical records and relational integrity.
     */
    match /users/{userId}/patients/{patientId}/records/{recordId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.patientId == patientId;
      allow update: if isExistingOwner(userId) && request.resource.data.patientId == resource.data.patientId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for doctor-patient relationships.
     * @path /doctors/{doctorId}/patients/{patientId}
     * @allow (get, list) - If the requesting user is the doctor.
     * @allow (create) - if false; // TODO: Add logic to allow the creation of this doucment only with a server function, as it may contain private patient data.
     * @allow (update) - if false;
     * @allow (delete) - if false;
     * @principle Doctors can only see a summary of their assigned patients.
     */
    match /doctors/{doctorId}/patients/{patientId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Rules for consultation requests.
     * @path /consultations/{consultationId}
     * @allow (get, list, create) - If the user is signed in.
     * @allow (update) - if false; // TODO: Add a check for doctors, patients and correct status of the consultations.
     * @allow (delete) - if false; // TODO: Add a check for doctors and patients depending on the status of the consultations.
     * @principle Allows authenticated users to manage consultations.
     */
    match /consultations/{consultationId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }
  }
}