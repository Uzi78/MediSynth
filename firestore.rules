/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control model for a telemedicine application.
 *
 * Data Structure:
 * - /users/{userId}: User profiles, containing role information (patient or doctor).
 * - /users/{userId}/patients/{patientId}: Full patient records, accessible only by the patient themselves.
 * - /users/{userId}/patients/{patientId}/records/{recordId}: Medical records for a patient, accessible only by the patient themselves.
 * - /doctors/{doctorId}: Public-facing doctor profiles.
 * - /doctors/{doctorId}/patients/{patientId}: Summaries of a doctor's patients.
 * - /consultations/{consultationId}: Consultation requests.
 *
 * Key Security Decisions:
 * - User profiles are only accessible by the user themselves.
 * - Full patient records and medical records are accessible only by the patient.
 * - Doctor profiles are publicly readable.
 * - Doctor-patient summaries are accessible only by the doctor.
 * - The rules do NOT enforce strict data validation to allow for rapid prototyping and schema evolution.
 *
 * Denormalization for Authorization:
 * - The `UserProfile` document contains a `role` field which is used to determine authorization.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile information.
     * @path /users/{userId}
     * @allow (get, list, create, update, delete) User with ID 'user123' can access their own profile.
     * @deny (get, list, create, update, delete) User with ID 'user123' cannot access the profile of user 'user456'.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      // Allow the user to read their profile if signed in
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;

      // Allow user to create their own profile if the userId matches their auth id
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;

      // Allow the user to update their profile if signed in and they are the owner
      allow update: if isSignedIn() && isExistingOwner(userId) && request.resource.data.id == resource.data.id;

      // Allow the user to delete their profile if signed in and they are the owner
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Controls access to patient records, only accessible by the patient themselves.
     * @path /users/{userId}/patients/{patientId}
     * @allow (get, list, create, update, delete) User with ID 'user123' can access their own patient record with ID 'patient456'.
     * @deny (get, list, create, update, delete) User with ID 'user123' cannot access patient record 'patient789' or patient records of other users.
     * @principle Enforces document ownership for patient records.
     */
    match /users/{userId}/patients/{patientId} {

      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      // Allow the user to read their own patient records if signed in and they are the owner
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);

      // Allow user to create their own patient record if the userId matches their auth id
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == patientId;

      // Allow the user to update their own patient record if signed in and they are the owner
      allow update: if isSignedIn() && isExistingOwner(userId) && request.resource.data.id == resource.data.id;

      // Allow the user to delete their own patient record if signed in and they are the owner
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Controls access to medical records, only accessible by the patient.
     * @path /users/{userId}/patients/{patientId}/records/{recordId}
     * @allow (get, list, create, update, delete) User 'user123' can access record 'record456' if they own patient 'patient789'.
     * @deny (get, list, create, update, delete) User 'user123' cannot access record 'record456' if they do not own patient 'patient789'.
     * @principle Enforces strict patient-only access to medical records.
     */
    match /users/{userId}/patients/{patientId}/records/{recordId} {

      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      // Allow the user to read their own medical records if signed in and they are the owner
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);

      // Allow user to create their own medical record if the userId matches their auth id
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.patientId == patientId;

      // Allow the user to update their own medical record if signed in and they are the owner
      allow update: if isSignedIn() && isExistingOwner(userId) && request.resource.data.patientId == resource.data.patientId;

      // Allow the user to delete their own medical record if signed in and they are the owner
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Allows public read access to doctor profiles, with no write access.
     * @path /doctors/{doctorId}
     * @allow (get, list) Any user can read doctor profiles.
     * @deny (create, update, delete) No user can create, update, or delete doctor profiles through the client.
     * @principle Allows public reads with restricted writes.
     */
    match /doctors/{doctorId} {

      // Allow anyone to read doctor profiles
      allow get, list: if true;

      // No one can create, update, or delete doctor profiles through the client
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to doctor's patient summaries.
     * @path /doctors/{doctorId}/patients/{patientId}
     * @allow (get, list, create, update, delete) Doctor with ID 'doctor123' can access patient summary 'patient456'.
     * @deny (get, list, create, update, delete) User 'user123' cannot access patient summaries unless they are the doctor.
     * @principle Enforces doctor-only access to patient summaries.
     */
    match /doctors/{doctorId}/patients/{patientId} {

      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(doctorId) {
        return request.auth.uid == doctorId;
      }

      function isExistingOwner(doctorId) {
        return isOwner(doctorId) && resource != null;
      }

      // Allow the doctor to read their patient summaries if signed in and they are the owner
      allow get: if isSignedIn() && isOwner(doctorId);
      allow list: if isSignedIn() && isOwner(doctorId);

      // Allow doctor to create patient summary
      allow create: if isSignedIn() && isOwner(doctorId);

      // Allow the doctor to update their patient summary if signed in and they are the owner
      allow update: if isSignedIn() && isExistingOwner(doctorId);

      // Allow the doctor to delete their patient summary if signed in and they are the owner
      allow delete: if isSignedIn() && isExistingOwner(doctorId);
    }

    /**
     * @description Controls access to consultation requests.
     * @path /consultations/{consultationId}
     * @allow (get, list, create, update, delete) Any authenticated user can create a consultation request. Access to reading, updating, and deleting is not explicitly restricted and should be reviewed for stricter controls in a production environment.
     * @deny No specific denials are defined, but more restrictive rules should be considered, particularly for sensitive consultation data.
     * @principle Provides minimal restrictions on consultation requests and requires further review.
     */
    match /consultations/{consultationId} {
      function isSignedIn() {
        return request.auth != null;
      }

      // Allow any signed-in user to read consultations. Consider more restrictive rules.
      allow get, list: if isSignedIn();

      // Allow any signed-in user to create a consultation.
      allow create: if isSignedIn();

      // Allow any signed-in user to update consultations. Consider more restrictive rules.
      allow update: if isSignedIn() && resource != null;

      // Allow any signed-in user to delete consultations. Consider more restrictive rules.
      allow delete: if isSignedIn() && resource != null;
    }
  }
}