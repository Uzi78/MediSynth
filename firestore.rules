/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control system with owner-only and public read patterns.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information, including their role (patient/doctor).
 * - /users/{userId}/patients/{patientId}: Stores full patient data, only accessible by the patient themselves.
 * - /users/{userId}/patients/{patientId}/records/{recordId}: Stores medical records for a patient, only accessible by the patient.
 * - /doctors/{doctorId}: Stores public-facing doctor profile information.
 * - /doctors/{doctorId}/patients/{patientId}: Stores summarized patient data for a doctor's list view.
 * - /consultations/{consultationId}: Stores consultation requests.
 *
 * Key Security Decisions:
 * - User listing is disallowed for privacy.
 * - Doctor profiles are publicly readable.
 * - Default security posture is strict owner-only access unless explicitly specified otherwise.
 * - Consultation requests can be created by patients for a specific doctor. Doctors and patients involved can read the consultation.
 *
 * Denormalization for Authorization:
 * - Patient documents are stored under /users/{userId}/patients/{patientId} to easily enforce patient ownership.
 * - DoctorPatient summaries are stored under /doctors/{doctorId}/patients/{patientId} to facilitate efficient doctor-specific patient lists.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces user-level access control for profile data.
     * @path /users/{userId}
     * @allow (create) User with matching ID can create their profile.
     * @allow (get, list, update, delete) User with matching ID can read, update, and delete their profile.
     * @deny (create) User tries to create a profile with a different ID.
     * @deny (update, delete) A non-existent profile cannot be updated or deleted.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && resource != null;
      allow delete: if isOwner(userId) && resource != null;
    }

    /**
     * @description Enforces patient-level access control under a user's profile.
     * @path /users/{userId}/patients/{patientId}
     * @allow (create) User with matching ID can create a patient document.
     * @allow (get, list, update, delete) User with matching ID can read, update, and delete their patient document.
     * @deny (create) User tries to create a patient document with a different ID.
     * @deny (update, delete) A non-existent patient document cannot be updated or deleted.
     * @principle Enforces document ownership for patient data.
     */
    match /users/{userId}/patients/{patientId} {
       function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && resource != null;
      allow delete: if isOwner(userId) && resource != null;
    }

    /**
     * @description Enforces record-level access control under a patient's profile.
     * @path /users/{userId}/patients/{patientId}/records/{recordId}
     * @allow (create) User with matching ID can create a record document.
     * @allow (get, list, update, delete) User with matching ID can read, update, and delete their record document.
     * @deny (create) User tries to create a record document with a different ID.
     * @deny (update, delete) A non-existent record document cannot be updated or deleted.
     * @principle Enforces document ownership for patient records.
     */
    match /users/{userId}/patients/{patientId}/records/{recordId} {
       function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && resource != null;
      allow delete: if isOwner(userId) && resource != null;
    }

     /**
      * @description Allows public read access to doctor profiles.
      * @path /doctors/{doctorId}
      * @allow (get, list) Anyone can read doctor profiles.
      * @allow (create, update, delete) Only the doctor (owner) can create, update, or delete their profile.
      * @deny (create) Non-owner tries to create a doctor profile.
      * @deny (update, delete) Non-owner tries to update/delete a doctor profile.
      * @principle Public read, owner-only write access for doctor profiles.
      */
    match /doctors/{doctorId} {
       function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(doctorId) {
        return request.auth.uid == doctorId;
      }
      allow get: if true;
      allow list: if true;
      allow create: if isOwner(doctorId);
      allow update: if isOwner(doctorId) && resource != null;
      allow delete: if isOwner(doctorId) && resource != null;
    }

    /**
     * @description DoctorPatient entries are readable by the doctor and writable only by the system.
     * @path /doctors/{doctorId}/patients/{patientId}
     * @allow (get, list) Doctor can read patient summary.
     * @deny (create, update, delete) No one can create, update, or delete directly.
     * @principle Doctor-only access to patient summaries.
     */
    match /doctors/{doctorId}/patients/{patientId} {
       function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(doctorId) {
        return request.auth.uid == doctorId;
      }

      allow get: if isOwner(doctorId);
      allow list: if isOwner(doctorId);
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to consultation requests.
     * @path /consultations/{consultationId}
     * @allow (create) Any signed-in user can create a consultation request.
     * @allow (get) Only the patient or doctor involved in the consultation can read it.
     * @allow (list) No listing of consultations.
     * @allow (update) No update once the consultation is created.
     * @allow (delete) No deletion once the consultation is created.
     * @principle Allows creation by signed-in users, restricts read access to participants.
     */
    match /consultations/{consultationId} {
       function isSignedIn() {
        return request.auth != null;
      }

      function isParticipant(consultation) {
        return request.auth.uid == consultation.patientId || request.auth.uid == consultation.doctorId;
      }

      allow get: if isSignedIn() && isParticipant(resource.data);
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.patientId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }
  }
}