/**
 * @file Firebase Security Rules for Prototyping
 *
 * @core_philosophy This ruleset enforces a strict user-ownership model for patient data and allows public read access to doctor profiles and consultations.
 *
 * @data_structure
 *   - /users/{userId}: Stores user profile data (role).
 *   - /users/{userId}/patients/{patientId}: Stores detailed patient information, accessible only by the patient.
 *   - /users/{userId}/patients/{patientId}/records/{recordId}: Stores patient medical records, accessible only by the patient.
 *   - /doctors/{doctorId}: Stores public doctor profile information.
 *   - /doctors/{doctorId}/patients/{patientId}: Stores a doctor's patients summary view, accessible only by the doctor.
 *   - /consultations/{consultationId}: Stores consultation requests, publicly accessible for listing, but creation is open
 *
 * @key_security_decisions
 *   - Users can only access their own patient data and records.
 *   - Doctors can only access their own doctor-patient mappings
 *   - Doctor profiles are publicly readable.
 *   - Consultations are publicly listable.
 *
 * @denormalization_for_authorization
 *   - DoctorPatient documents require `doctorId` and `patientId` fields to quickly verify access for doctor-specific patient lists.
 *
 * @structural_segregation
 *   - Patient data is stored under the `/users/{userId}` path to ensure private access.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile information.
     * @path /users/{userId}
     * @allow (create) User with matching UID can create their profile.
     * @allow (get, list, update, delete) User with matching UID can read and modify their profile.
     * @deny (create) User cannot create a profile with a mismatched UID.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isSignedIn() {
          return request.auth != null;
      }
      allow get, list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update, delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Controls access to patient data for a specific user.
     * @path /users/{userId}/patients/{patientId}
     * @allow (create) User with matching UID can create patient data for themselves.
     * @allow (get, list, update, delete) User with matching UID can read and modify their own patient data.
     * @deny (create) User cannot create patient data with a mismatched UID.
     * @principle Enforces document ownership for writes and ensures data consistency between path and document fields.
     */
    match /users/{userId}/patients/{patientId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isSignedIn() {
          return request.auth != null;
      }
      allow get, list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update, delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Controls access to medical records for a specific patient.
     * @path /users/{userId}/patients/{patientId}/records/{recordId}
     * @allow (create) User with matching UID can create medical records for their own patient data.
     * @allow (get, list, update, delete) User with matching UID can read and modify their own patient medical records.
     * @deny (create) User cannot create medical records with a mismatched UID.
     * @principle Enforces document ownership for writes and ensures data consistency between path and document fields.
     */
    match /users/{userId}/patients/{patientId}/records/{recordId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isSignedIn() {
          return request.auth != null;
      }
      allow get, list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update, delete: if isSignedIn() && isOwner(userId);
    }
    
    /**
     * @description Controls access to doctor profile information.
     * @path /doctors/{doctorId}
     * @allow (get, list) Anyone can read doctor profile information.
     * @allow (create, update, delete) Only the doctor with matching UID can create, update, or delete their profile.
     * @principle Allows public read access for doctor profiles while enforcing ownership for writes.
     */
    match /doctors/{doctorId} {
      function isOwner(doctorId) {
        return request.auth.uid == doctorId;
      }
      function isSignedIn() {
          return request.auth != null;
      }
      allow get, list: if true;
      allow create: if isSignedIn() && isOwner(doctorId);
      allow update, delete: if isSignedIn() && isOwner(doctorId);
    }

    /**
     * @description Controls access to a doctor's patient list.
     * @path /doctors/{doctorId}/patients/{patientId}
     * @allow (create) A doctor can create a DoctorPatient document for themselves.
     * @allow (get, list, update, delete) Only the doctor with the matching UID can manage their own patient list.
     * @deny (create) A doctor cannot create a DoctorPatient document with a mismatched doctorId.
     * @principle Enforces document ownership and relational integrity for doctor-patient mappings.
     */
    match /doctors/{doctorId}/patients/{patientId} {
      function isOwner(doctorId) {
        return request.auth.uid == doctorId;
      }
      function isSignedIn() {
          return request.auth != null;
      }
      allow get, list: if isSignedIn() && isOwner(doctorId);
      allow create: if isSignedIn() && isOwner(doctorId);
      allow update, delete: if isSignedIn() && isOwner(doctorId);
    }

    /**
     * @description Controls access to consultation requests.
     * @path /consultations/{consultationId}
     * @allow (get, list) Anyone can read consultation requests.
     * @allow (create) Any signed in user can create a consultation request
     * @allow (update, delete) Only the user who created the consultation can modify or delete it.
     * @principle Allows public read access for consultations while enforcing ownership for writes.
     */
    match /consultations/{consultationId} {
      function isSignedIn() {
          return request.auth != null;
      }
       allow get, list: if true;
       allow create: if isSignedIn();
       allow update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }
  }
}