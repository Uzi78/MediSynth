/**
 * @file Firebase Security Rules for Firestore.
 *
 * @core_philosophy This ruleset enforces a strict user-ownership model for personal data
 * and a public-read, owner-write model for doctor profiles. Consultations are accessible
 * to the patient and doctor involved.
 *
 * @data_structure
 * - /users/{userId}: Stores user profiles, accessible only by the user.
 * - /users/{userId}/patients/{patientId}: Stores detailed patient records, accessible only by the user.
 * - /users/{userId}/patients/{patientId}/records/{recordId}: Stores medical records, accessible only by the user.
 * - /doctors/{doctorId}: Stores public doctor profiles, readable by anyone, writable only by the doctor.
 * - /doctors/{doctorId}/patients/{patientId}: Stores doctor-patient relationships for list views, writable only by the doctor.
 * - /consultations/{consultationId}: Stores consultation requests, accessible to the patient and doctor.
 * - /consultations/{consultationId}/messages/{messageId}: Stores chat messages for consultations, accessible to the patient and doctor.
 *
 * @key_security_decisions
 * - Users can only access their own data.
 * - Doctors can create and modify their own public profiles.
 * - Doctors can manage their patient lists.
 * - Consultations are private between the patient and the doctor.
 * - Listing of user documents is disallowed for security.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user ID matches the provided user ID.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the owner of an existing document.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the authenticated user is one of the participants in a consultation.
     */
    function isConsultationParticipant(patientId, doctorId) {
      return request.auth.uid == patientId || request.auth.uid == doctorId;
    }

    /**
     * @description Rules for user profiles.
     * @path /users/{userId}
     * @allow (create) User with UID 'user123' can create their profile document.
     * @allow (get) User with UID 'user123' can read their profile document.
     * @deny (update) User with UID 'user456' cannot update the profile document of user 'user123'.
     * @deny (delete) User with UID 'user456' cannot delete the profile document of user 'user123'.
     * @principle Enforces document ownership for writes, restricts access to a user's own data.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for patient records under a user.
     * @path /users/{userId}/patients/{patientId}
     * @allow (create) User with UID 'user123' can create a patient document under their profile.
     * @allow (get) User with UID 'user123' can read a patient document under their profile.
     * @deny (update) User with UID 'user456' cannot update a patient document under the profile of user 'user123'.
     * @deny (delete) User with UID 'user456' cannot delete a patient document under the profile of user 'user123'.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /users/{userId}/patients/{patientId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for medical records under a patient.
     * @path /users/{userId}/patients/{patientId}/records/{recordId}
     * @allow (create) User with UID 'user123' can create a medical record under their patient's profile.
     * @allow (get) User with UID 'user123' can read a medical record under their patient's profile.
     * @deny (update) User with UID 'user456' cannot update a medical record under the profile of user 'user123'.
     * @deny (delete) User with UID 'user456' cannot delete a medical record under the profile of user 'user123'.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /users/{userId}/patients/{patientId}/records/{recordId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for doctor profiles.
     * @path /doctors/{doctorId}
     * @allow (get) Any user can read doctor profiles.
     * @allow (create) Doctor with UID 'doctor123' can create their profile document.
     * @deny (update) User with UID 'user456' cannot update the profile document of doctor 'doctor123'.
     * @deny (delete) User with UID 'user456' cannot delete the profile document of doctor 'doctor123'.
     * @principle Allows public reads, enforces document ownership for writes.
     */
    match /doctors/{doctorId} {
      allow get: if true;
      allow list: if true;
      allow create: if isOwner(doctorId);
      allow update: if isExistingOwner(doctorId);
      allow delete: if isExistingOwner(doctorId);
    }

    /**
     * @description Rules for doctor-patient relationships.
     * @path /doctors/{doctorId}/patients/{patientId}
     * @allow (create) Doctor with UID 'doctor123' can create a patient relationship document.
     * @allow (get) Doctor with UID 'doctor123' can read a patient relationship document.
     * @deny (update) User with UID 'user456' cannot update a patient relationship document of doctor 'doctor123'.
     * @deny (delete) User with UID 'user456' cannot delete a patient relationship document of doctor 'doctor123'.
     */
    match /doctors/{doctorId}/patients/{patientId} {
      allow get: if isOwner(doctorId);
      allow list: if isOwner(doctorId);
      allow create: if isOwner(doctorId);
      allow update: if isExistingOwner(doctorId);
      allow delete: if isExistingOwner(doctorId);
    }

    /**
     * @description Rules for consultations.
     * @path /consultations/{consultationId}
     * @allow (get) User with UID 'user123' (either patient or doctor) can read a consultation document.
     * @allow (create) User with UID 'user123' can create a consultation document.
     * @deny (update) User with UID 'user456' cannot update the consultation document.
     *
     */
    match /consultations/{consultationId} {
        allow get: if isConsultationParticipant(resource.data.patientId, resource.data.doctorId);
        allow list: if false;
        allow create: if isSignedIn();
        allow update: if false;
        allow delete: if false;
    }

    /**
     * @description Rules for messages within a consultation.
     * @path /consultations/{consultationId}/messages/{messageId}
     * @allow (create) User with UID 'user123' (either patient or doctor) can create a message in a consultation.
     * @allow (get) User with UID 'user123' (either patient or doctor) can read a message in a consultation.
     * @deny (update) User with UID 'user456' cannot update a message.
     */
    match /consultations/{consultationId}/messages/{messageId} {
        allow get: if isConsultationParticipant(get(/databases/$(database)/documents/consultations/$(consultationId)).data.patientId, get(/databases/$(database)/documents/consultations/$(consultationId)).data.doctorId);
        allow list: if isConsultationParticipant(get(/databases/$(database)/documents/consultations/$(consultationId)).data.patientId, get(/databases/$(database)/documents/consultations/$(consultationId)).data.doctorId);
        allow create: if isSignedIn() && (request.resource.data.senderId == request.auth.uid);
        allow update: if false;
        allow delete: if false;
    }
  }
}