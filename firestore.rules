/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for patient data, with doctors having limited access to assigned patients.
 * Consultations are accessible to both the patient and the assigned doctor.
 * Public doctor profiles are readable by anyone.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile data, role is in document.
 * - /users/{userId}/patients/{patientId}: Stores patient data.
 * - /users/{userId}/patients/{patientId}/records/{recordId}: Stores medical records for a patient.
 * - /doctors/{doctorId}: Stores public-facing information for doctors.
 * - /doctors/{doctorId}/patients/{patientId}: Stores a summary of doctor-patient relationships.
 * - /consultations/{consultationId}: Stores consultation requests and lifecycle data.
 *
 * Key Security Decisions:
 * - Users can only access their own profile data.
 * - Patients can only access their own patient data and records.
 * - Doctors can only access patient summaries for their assigned patients.
 * - Consultations are accessible to both the patient and the assigned doctor.
 * - Doctor profiles are publicly readable.
 * - User listing is not allowed.
 *
 * Denormalization for Authorization:
 * - Patient documents are nested under `/users/{userId}` to simplify ownership checks.
 * - The `patientId` is present in the `/doctors/{doctorId}/patients/{patientId}` collection to allow easy linking between doctors and patients.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile information.
     * @path /users/{userId}
     * @allow (create) User with matching ID can create their profile.
     * @allow (get, update, delete) User with matching ID can access their profile.
     * @deny (create, get, update, delete) User with non-matching ID cannot access this profile.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow get, update, delete: if isOwner(userId);
      allow list: if false;
    }

    /**
     * @description Controls access to patient data for a specific user.
     * @path /users/{userId}/patients/{patientId}
     * @allow (create) User with matching ID can create patient data under their profile.
     * @allow (get, update, delete) User with matching ID can access their patient data.
     * @deny (create, get, update, delete) User with non-matching ID cannot access this patient data.
     * @principle Enforces document ownership for patient data.
     */
    match /users/{userId}/patients/{patientId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      allow create: if isOwner(userId);
      allow get, update, delete: if isOwner(userId);
      allow list: if isOwner(userId);
    }

    /**
     * @description Controls access to medical records for a specific patient.
     * @path /users/{userId}/patients/{patientId}/records/{recordId}
     * @allow (create) User with matching ID can create records under their patient data.
     * @allow (get, update, delete) User with matching ID can access their patient records.
     * @deny (create, get, update, delete) User with non-matching ID cannot access these records.
     * @principle Enforces document ownership for medical records.
     */
    match /users/{userId}/patients/{patientId}/records/{recordId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow create: if isOwner(userId);
      allow get, update, delete: if isOwner(userId);
      allow list: if isOwner(userId);
    }

        /**
         * @description Controls access to doctor profiles. Doctor profiles are publicly readable.
         * @path /doctors/{doctorId}
         * @allow (get, list) Anyone can read doctor profiles.
         * @deny (create, update, delete) Only the doctor can modify their profile (not yet implemented).
         * @principle Allows public read access to doctor profiles but restricts write access.
         */
        match /doctors/{doctorId} {
            allow get, list: if true;
            allow create, update, delete: if false; // TODO: Implement doctor-only write access
        }

        /**
         * @description Controls access to doctor-patient relationships.
         * @path /doctors/{doctorId}/patients/{patientId}
         * @allow (get, list) Doctors can view their assigned patients.
         * @deny (create, update, delete) Only the system can manage doctor-patient assignments (not yet implemented).
         */
        match /doctors/{doctorId}/patients/{patientId} {
            function isDoctor(doctorId) {
                return request.auth != null && request.auth.uid == doctorId;
            }
            allow get, list: if isDoctor(doctorId); // Doctors can view summaries of their patients
            allow create, update, delete: if false; // TODO: Restrict to backend only using custom claims
        }

        /**
         * @description Controls access to consultations.
         * @path /consultations/{consultationId}
         * @allow (get, update) Only the patient or the assigned doctor can access the consultation.
         * @allow (create) Any authenticated user can request a consultation.
         * @deny (delete) Consultations cannot be deleted.
         * @principle Allows read/write access to consultations for involved parties.
         */
        match /consultations/{consultationId} {
            function isParticipant(patientId, doctorId) {
                return request.auth != null && (request.auth.uid == patientId || request.auth.uid == doctorId);
            }

            allow create: if request.auth != null; // Any authenticated user can request a consultation.
            allow get, update: if isParticipant(resource.data.patientId, resource.data.doctorId);
            allow delete: if false;
            allow list: if false; // prevent listing of consultations
        }
  }
}