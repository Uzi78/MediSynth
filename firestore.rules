/**
 * @fileoverview Firestore Security Rules for the medical records application.
 *
 * Core Philosophy:
 * This ruleset enforces a combination of user-ownership and role-based access control.
 * - Users can only access their own profile data.
 * - Doctors can only access patient summary data for their assigned patients.
 * - Consultations are accessible to both the patient and the doctor involved.
 *
 * Data Structure:
 * - User profiles are stored under `/users/{userId}`.
 * - Patient records are nested under `/users/{userId}/patients/{patientId}/records/{recordId}` for strict ownership.
 * - Doctor profiles are stored under `/doctors/{doctorId}` and doctor-patient summaries under `/doctors/{doctorId}/patients/{patientId}`.
 * - Consultations are stored in a top-level collection `/consultations/{consultationId}`.
 *
 * Key Security Decisions:
 * - Users cannot list all users (or doctors cannot list all patients). List operations are restricted to subcollections to prevent data leakage.
 * - DoctorPatient documents are used to efficiently determine which patients a doctor can access.
 *
 * Denormalization for Authorization:
 * - The DoctorPatient entity is used to denormalize the doctor-patient relationship, allowing for efficient rules.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure root access. All requests must originate from an authenticated user.
     * @path /databases/{database}/documents
     * @allow get, list: if false;
     * @allow create, update, delete: if false;
     * @deny get: if true;
     * @deny list: if true;
     * @deny create: if true;
     * @deny update: if true;
     * @deny delete: if true;
     * @principle Root level access is forbidden.
     */
    match /{document=**} {
        allow read, write: if false;
    }

    /**
     * @description Manages user profile information. Only the user can read/write their own profile.
     * @path /users/{userId}
     * @allow get: if isSignedIn() && isOwner(userId);
     * @allow list: if false;
     * @allow create: if isSignedIn() && isOwner(userId);
     * @allow update: if isSignedIn() && isOwner(userId);
     * @allow delete: if isExistingOwner(userId);
     * @deny get: if !isSignedIn();
     * @deny create: if !isSignedIn() || !isNewOwner(userId);
     * @deny update: if !isSignedIn() || !isExistingOwner(userId);
     * @deny delete: if !isSignedIn() || !isExistingOwner(userId);
     * @principle Enforces user-ownership for profile data.
     */
    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages patient data for a specific user. Only the user can read/write their own patient data.
     * @path /users/{userId}/patients/{patientId}
     * @allow get: if isSignedIn() && isOwner(userId);
     * @allow list: if isSignedIn() && isOwner(userId);
     * @allow create: if isSignedIn() && isOwner(userId);
     * @allow update: if isSignedIn() && isOwner(userId);
     * @allow delete: if isExistingOwner(userId);
     * @deny get: if !isSignedIn() || !isOwner(userId);
     * @deny list: if !isSignedIn() || !isOwner(userId);
     * @deny create: if !isSignedIn() || !isNewOwner(userId);
     * @deny update: if !isSignedIn() || !isExistingOwner(userId);
     * @deny delete: if !isSignedIn() || !isExistingOwner(userId);
     * @principle Enforces user-ownership for patient records.
     */
    match /users/{userId}/patients/{patientId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && request.resource.data.id == patientId;
      allow update: if isSignedIn() && isExistingOwner(userId) && resource.data.id == patientId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages medical records for a specific patient. Only the patient (owner) can read/write the records.
     * @path /users/{userId}/patients/{patientId}/records/{recordId}
     * @allow get: if isSignedIn() && isOwner(userId);
     * @allow list: if isSignedIn() && isOwner(userId);
     * @allow create: if isSignedIn() && isOwner(userId);
     * @allow update: if isSignedIn() && isExistingOwner(userId);
     * @allow delete: if isExistingOwner(userId);
     * @deny get: if !isSignedIn() || !isOwner(userId);
     * @deny list: if !isSignedIn() || !isOwner(userId);
     * @deny create: if !isSignedIn() || !isNewOwner(userId);
     * @deny update: if !isSignedIn() || !isExistingOwner(userId);
     * @deny delete: if !isSignedIn() || !isExistingOwner(userId);
     * @principle Enforces user-ownership for medical records.
     */
    match /users/{userId}/patients/{patientId}/records/{recordId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.patientId == patientId;
      allow update: if isSignedIn() && isExistingOwner(userId) && resource.data.patientId == patientId;
      allow delete: if isExistingOwner(userId);
    }

     /**
      * @description Doctor profiles are public, allowing anyone to read them.
      * @path /doctors/{doctorId}
      * @allow get, list: if true;
      * @allow create: if isSignedIn() && isOwner(doctorId);
      * @allow update: if isSignedIn() && isExistingOwner(doctorId);
      * @allow delete: if isExistingOwner(doctorId);
      * @deny create: if !isSignedIn() || !isOwner(doctorId);
      * @deny update: if !isSignedIn() || !isExistingOwner(doctorId);
      * @deny delete: if !isSignedIn() || !isExistingOwner(doctorId);
      * @principle Doctor profiles are publicly readable, but writable only by the doctor themselves.
      */
    match /doctors/{doctorId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && isOwner(doctorId);
      allow update: if isSignedIn() && isExistingOwner(doctorId);
      allow delete: if isExistingOwner(doctorId);
    }

    /**
     * @description DoctorPatient summaries can only be read by the specified doctor. This is to populate the My Patients tab.
     * @path /doctors/{doctorId}/patients/{patientId}
     * @allow get: if isSignedIn() && isOwner(doctorId);
     * @allow list: if isSignedIn() && isOwner(doctorId);
     * @allow create: if isSignedIn() && isOwner(doctorId);
     * @allow update: if isSignedIn() && isExistingOwner(doctorId);
     * @allow delete: if isExistingOwner(doctorId);
     * @deny get: if !isSignedIn() || !isOwner(doctorId);
     * @deny list: if !isSignedIn() || !isOwner(doctorId);
     * @deny create: if !isSignedIn() || !isOwner(doctorId);
     * @deny update: if !isSignedIn() || !isExistingOwner(doctorId);
     * @deny delete: if !isSignedIn() || !isExistingOwner(doctorId);
     * @principle Restricts access to doctor-patient summaries to the assigned doctor.
     */
    match /doctors/{doctorId}/patients/{patientId} {
      allow get: if isSignedIn() && isOwner(doctorId);
      allow list: if isSignedIn() && isOwner(doctorId);
      allow create: if isSignedIn() && isOwner(doctorId);
      allow update: if isSignedIn() && isExistingOwner(doctorId);
      allow delete: if isExistingOwner(doctorId);
    }

    /**
     * @description Consultations are accessible to both the patient and the doctor involved.
     * @path /consultations/{consultationId}
     * @allow get: if isSignedIn() && (resource.data.patientId == request.auth.uid || resource.data.doctorId == request.auth.uid);
     * @allow list: if isSignedIn() && (resource.data.patientId == request.auth.uid || resource.data.doctorId == request.auth.uid);
     * @allow create: if isSignedIn() && (request.resource.data.patientId == request.auth.uid || request.resource.data.doctorId == request.auth.uid);
     * @allow update: if isSignedIn() && isExistingConsultationParticipant(resource.data.patientId, resource.data.doctorId);
     * @allow delete: if isExistingConsultationParticipant(resource.data.patientId, resource.data.doctorId);
     * @deny get: if !isSignedIn() || !(resource.data.patientId == request.auth.uid || resource.data.doctorId == request.auth.uid);
     * @deny list: if !isSignedIn() || !(resource.data.patientId == request.auth.uid || resource.data.doctorId == request.auth.uid);
     * @deny create: if !isSignedIn() || !(request.resource.data.patientId == request.auth.uid || request.resource.data.doctorId == request.auth.uid);
     * @deny update: if !isSignedIn() || !isExistingConsultationParticipant(resource.data.patientId, resource.data.doctorId);
     * @deny delete: if !isSignedIn() || !isExistingConsultationParticipant(resource.data.patientId, resource.data.doctorId);
     * @principle Allows both patient and doctor to manage consultations they are involved in.
     */
    match /consultations/{consultationId} {
      allow get: if isSignedIn() && (resource.data.patientId == request.auth.uid || resource.data.doctorId == request.auth.uid);
      allow list: if isSignedIn() && (resource.data.patientId == request.auth.uid || resource.data.doctorId == request.auth.uid);
      allow create: if isSignedIn() && (request.resource.data.patientId == request.auth.uid || request.resource.data.doctorId == request.auth.uid);
      allow update: if isSignedIn() && isExistingConsultationParticipant(resource.data.patientId, resource.data.doctorId);
      allow delete: if isExistingConsultationParticipant(resource.data.patientId, resource.data.doctorId);
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isNewOwner(userId) {
        return request.resource.data.id == userId;
    }

    function isExistingOwner(userId) {
      return isSignedIn() && isOwner(userId) && resource != null;
    }

    function isExistingConsultationParticipant(patientId, doctorId) {
        return isSignedIn() && (resource.data.patientId == request.auth.uid || resource.data.doctorId == request.auth.uid) && resource != null;
    }
  }
}