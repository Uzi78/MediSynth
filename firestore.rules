/**
 * @fileoverview Firestore Security Rules for the medical records application.
 *
 * Core Philosophy:
 * This ruleset employs a strict user-ownership model for patient data, ensuring that only authenticated users can access their own profiles and medical records. Doctor profiles are publicly readable, but only doctors can manage their assigned patient summaries. Consultations are accessible to both the patient and the doctor involved.
 *
 * Data Structure:
 * - User profiles are stored under `/users/{userId}`.
 * - Patients are stored under `/users/{userId}/patients/{patientId}`.
 * - Medical records are stored under `/users/{userId}/patients/{patientId}/records/{recordId}`.
 * - Doctor profiles are stored under `/doctors/{doctorId}`.
 * - Doctor-patient relationships (summary data) are stored under `/doctors/{doctorId}/patients/{patientId}`.
 * - Consultations are stored under `/consultations/{consultationId}`.
 *
 * Key Security Decisions:
 * - Users can only create their own profile.
 * - Patients can only access their own patient data and medical records.
 * - Doctors can read doctor profiles.
 * - Doctor's patient summaries can only be managed by the doctor.
 * - Consultations are accessible to both the patient and the doctor involved.
 * - Listing of users, patients, and records is restricted.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile information.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' can create their own profile.
     *   - Request: auth.uid = 'user123', resource.data.id = 'user123'
     * @deny (create) User with ID 'user123' cannot create a profile for another user.
     *   - Request: auth.uid = 'user123', resource.data.id = 'user456'
     * @allow (get) User with ID 'user123' can read their profile.
     *   - Request: auth.uid = 'user123'
     * @deny (update) User with ID 'user123' cannot update another user's profile.
     *   - Request: auth.uid = 'user456'
     * @deny (delete) User with ID 'user123' cannot delete another user's profile.
     *   - Request: auth.uid = 'user456'
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isOwner(userId) && resource.data.id == userId;
      allow delete: if isOwner(userId) && resource.data.id == userId && resource != null;
    }

    /**
     * @description Controls access to patient data nested under a user.
     * @path /users/{userId}/patients/{patientId}
     * @allow (create) User with ID 'user123' can create patient data for themselves.
     *   - Request: auth.uid = 'user123', resource.data.id = 'patient456'
     * @deny (create) User with ID 'user123' cannot create patient data for another user.
     *   - Request: auth.uid = 'user123', resource.data.id = 'patient789'
     * @allow (get) User with ID 'user123' can read their own patient data.
     *   - Request: auth.uid = 'user123'
     * @deny (update) User with ID 'user123' cannot update another user's patient data.
     *   - Request: auth.uid = 'user456'
     * @deny (delete) User with ID 'user123' cannot delete another user's patient data.
     *   - Request: auth.uid = 'user456'
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/patients/{patientId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == patientId;
      allow update: if isOwner(userId) && resource.data.id == patientId  && resource != null;
      allow delete: if isOwner(userId) && resource.data.id == patientId && resource != null;
    }

    /**
     * @description Controls access to medical records nested under patient data.
     * @path /users/{userId}/patients/{patientId}/records/{recordId}
     * @allow (create) User with ID 'user123' can create medical records for their patient 'patient456'.
     *   - Request: auth.uid = 'user123'
     * @deny (create) User with ID 'user123' cannot create medical records for another user's patient.
     *   - Request: auth.uid = 'user456'
     * @allow (get) User with ID 'user123' can read their own patient's medical records.
     *   - Request: auth.uid = 'user123'
     * @deny (update) User with ID 'user123' cannot update another user's patient's medical records.
     *   - Request: auth.uid = 'user456'
     * @deny (delete) User with ID 'user123' cannot delete another user's patient's medical records.
     *   - Request: auth.uid = 'user456'
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/patients/{patientId}/records/{recordId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.patientId == patientId;
      allow update: if isOwner(userId) && resource.data.patientId == patientId && resource != null;
      allow delete: if isOwner(userId) && resource.data.patientId == patientId && resource != null;
    }

    /**
     * @description Controls access to doctor profile information.
     * @path /doctors/{doctorId}
     * @allow (get) Any user can read doctor profiles.
     *   - Request: auth.uid = 'anyUser'
     * @deny (create) Only the doctor with matching doctorId can create the document.
     *   - Request: auth.uid = 'user456'
     * @deny (update) Only the doctor with matching doctorId can update the document.
     *   - Request: auth.uid = 'user456'
     * @deny (delete) Only the doctor with matching doctorId can delete the document.
     *   - Request: auth.uid = 'user456'
     * @principle Allows public read access to doctor profiles, restricts write access to the doctor.
     */
    match /doctors/{doctorId} {
        function isOwner(doctorId) {
            return request.auth != null && request.auth.uid == doctorId;
        }

        allow get, list: if true;
        allow create: if isOwner(doctorId);
        allow update: if isOwner(doctorId) && resource != null;
        allow delete: if isOwner(doctorId) && resource != null;
    }

    /**
     * @description Controls access to doctor-patient relationships.
     * @path /doctors/{doctorId}/patients/{patientId}
     * @allow (create) Doctor with ID 'doctor789' can create a relationship with a patient.
     *   - Request: auth.uid = 'doctor789'
     * @deny (create) User with ID 'user123' cannot create a doctor-patient relationship.
     *   - Request: auth.uid = 'user123'
     * @allow (get) Doctor with ID 'doctor789' can read their patient relationships.
     *   - Request: auth.uid = 'doctor789'
     * @deny (update) User with ID 'user123' cannot update a doctor-patient relationship.
     *   - Request: auth.uid = 'user123'
     * @deny (delete) User with ID 'user123' cannot delete a doctor-patient relationship.
     *   - Request: auth.uid = 'user123'
     */
    match /doctors/{doctorId}/patients/{patientId} {
        function isOwner(doctorId) {
            return request.auth != null && request.auth.uid == doctorId;
        }

        allow get, list: if isOwner(doctorId);
        allow create: if isOwner(doctorId) && request.resource.data.patientId == patientId;
        allow update: if isOwner(doctorId) && resource.data.patientId == patientId && resource != null;
        allow delete: if isOwner(doctorId) && resource.data.patientId == patientId && resource != null;
    }

    /**
     * @description Controls access to consultations.
     * @path /consultations/{consultationId}
     * @allow (create) A signed-in user can create a consultation.
     *   - Request: auth.uid != null
     * @allow (get) Only the patient or doctor involved in the consultation can get it.
     *   - Request: auth.uid = 'user123' or 'doctor456'
     * @deny (update) Only the patient or doctor involved in the consultation can update it.
     *   - Request: auth.uid = 'user789'
     * @deny (delete) Only the patient or doctor involved in the consultation can delete it.
     *   - Request: auth.uid = 'user789'
     * @principle Allows shared access between the patient and doctor involved in the consultation.
     */
    match /consultations/{consultationId} {
      function isParticipant(consultation) {
        return request.auth != null && (request.auth.uid == consultation.data.patientId || request.auth.uid == consultation.data.doctorId);
      }
      allow get: if isSignedIn() && isParticipant(resource);
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isParticipant(resource) && resource != null;
      allow delete: if isSignedIn() && isParticipant(resource) && resource != null;
    }

    function isSignedIn() {
      return request.auth != null;
    }
  }
}