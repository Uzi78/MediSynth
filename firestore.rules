/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control model,
 * allowing fine-grained control over data access based on user roles (patient, doctor)
 * and resource ownership.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information (role).
 * - /users/{userId}/patients/{patientId}: Stores patient data, accessible only by the patient.
 * - /users/{userId}/patients/{patientId}/records/{recordId}: Stores medical records, accessible only by the patient.
 * - /doctors/{doctorId}: Stores doctor profile information, publicly readable, writable by the doctor.
 * - /doctors/{doctorId}/patients/{patientId}: Stores doctor-patient relationship summaries, accessible only by the doctor.
 * - /consultations/{consultationId}: Stores consultation requests, accessible by involved doctor and patient.
 * - /consultations/{consultationId}/messages/{messageId}: Stores chat messages for a specific consultation, accessible by involved doctor and patient.
 *
 * Key Security Decisions:
 * - User listing is disallowed.
 * - Doctor profiles are publicly readable.
 * - Patients can only access their own data.
 * - Doctors can only access summaries of their patients.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages user profile data.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' creates their own profile.
     * @allow (get) User with ID 'user123' retrieves their own profile.
     * @allow (update) User with ID 'user123' updates their own profile.
     * @deny (create) User with ID 'user123' attempts to create a profile for 'user456'.
     * @deny (delete) User with ID 'user123' attempts to delete their own profile (deletion not allowed).
     * @principle Enforces document ownership; users can only manage their own profile.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && resource.data.id == userId;
      allow delete: if false;
    }

    /**
     * @description Manages patient data for a specific user.
     * @path /users/{userId}/patients/{patientId}
     * @allow (create) User with ID 'user123' creates a patient document for themselves.
     * @allow (get) User with ID 'user123' retrieves a patient document for themselves.
     * @allow (update) User with ID 'user123' updates a patient document for themselves.
     * @deny (create) User with ID 'user123' attempts to create a patient document for 'user456'.
     * @deny (delete) User with ID 'user123' attempts to delete a patient document for 'user456'.
     * @principle Restricts patient data access to the owning user.
     */
    match /users/{userId}/patients/{patientId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId) && resource != null;
    }

    /**
     * @description Manages medical records for a specific patient.
     * @path /users/{userId}/patients/{patientId}/records/{recordId}
     * @allow (create) User with ID 'user123' creates a record for their patient 'patient123'.
     * @allow (get) User with ID 'user123' retrieves a record for their patient 'patient123'.
     * @allow (update) User with ID 'user123' updates a record for their patient 'patient123'.
     * @deny (create) User with ID 'user123' attempts to create a record for 'user456'.
     * @deny (delete) User with ID 'user123' attempts to delete a record for 'user456'.
     * @principle Restricts record data access to the owning user.
     */
    match /users/{userId}/patients/{patientId}/records/{recordId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId) && resource != null;
    }

    /**
     * @description Manages doctor profile data.
     * @path /doctors/{doctorId}
     * @allow (get) Any user can read a doctor's profile.
     * @allow (create) Doctor with ID 'doctor123' creates their own profile.
     * @allow (update) Doctor with ID 'doctor123' updates their own profile.
     * @deny (create) User with ID 'user123' attempts to create a profile for 'doctor456'.
     * @deny (delete) User with ID 'doctor123' attempts to delete their own profile (deletion not allowed).
     * @principle Enforces document ownership for writes, allows public reads.
     */
    match /doctors/{doctorId} {
      allow get: if true;
      allow list: if false;
      allow create: if isOwner(doctorId);
      allow update: if isOwner(doctorId) && resource != null;
      allow delete: if false;
    }

    /**
     * @description Manages doctor-patient relationship summaries.
     * @path /doctors/{doctorId}/patients/{patientId}
     * @allow (create) Doctor with ID 'doctor123' creates a patient summary.
     * @allow (get) Doctor with ID 'doctor123' retrieves a patient summary.
     * @allow (update) Doctor with ID 'doctor123' updates a patient summary.
     * @deny (create) User with ID 'user123' attempts to create a patient summary for 'doctor456'.
     * @deny (delete) User with ID 'doctor123' attempts to delete a patient summary for 'doctor456'.
     * @principle Restricts access to doctor-patient relationship summaries to the owning doctor.
     */
    match /doctors/{doctorId}/patients/{patientId} {
      allow get: if isOwner(doctorId);
      allow list: if isOwner(doctorId);
      allow create: if isOwner(doctorId);
      allow update: if isOwner(doctorId);
      allow delete: if isOwner(doctorId) && resource != null;
    }

    /**
     * @description Manages consultation requests.
     * @path /consultations/{consultationId}
     * @allow (create) Any authenticated user can create a consultation request.
     * @allow (get) Any authenticated user can get a consultation request.
     * @allow (update) Any authenticated user can update a consultation request.
     * @deny (delete) No one is allowed to delete a consultation request.
     * @principle Allows anyone to create consultation requests, but restricts modification to owners.
     */
    match /consultations/{consultationId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if false;
    }

        /**
         * @description Manages chat messages for a specific consultation.
         * @path /consultations/{consultationId}/messages/{messageId}
         * @allow (create) Any authenticated user can create a message in a consultation.
         * @allow (get) Any authenticated user can get a message in a consultation.
         * @allow (update) Any authenticated user can update a message in a consultation.
         * @deny (delete) No one is allowed to delete a message in a consultation.
         * @principle Allows anyone to create messages in a consultation, but restricts modification to owners.
         */
        match /consultations/{consultationId}/messages/{messageId} {
          allow get: if isSignedIn();
          allow list: if isSignedIn();
          allow create: if isSignedIn();
          allow update: if false;
          allow delete: if false;
        }
  }

  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

  function isExistingOwner(userId) {
    return isOwner(userId) && resource != null;
  }
}