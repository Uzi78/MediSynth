/**
 * @file Firestore Security Rules
 * @version 2
 *
 * @description
 * This ruleset enforces a role-based and ownership-based access control model.
 * Doctors and Patients have separate data trees and different access privileges.
 *
 * Data Structure:
 * - /users/{userId}: User profile data, including role (patient or doctor).
 * - /users/{userId}/patients/{patientId}: Private patient data, accessible only by the patient.
 * - /users/{userId}/patients/{patientId}/records/{recordId}: Medical records, accessible only by the patient.
 * - /doctors/{doctorId}: Doctor profile information, publicly readable.
 * - /doctors/{doctorId}/patients/{patientId}: Summary patient data for doctors, only writable by doctors.
 * - /consultations/{consultationId}: Consultation requests.
 *
 * Key Security Decisions:
 * - Users can only create their own profiles.
 * - Patients can only access their own patient data and records.
 * - Doctors can read doctor profiles.
 * - Listing of user profiles is disallowed for privacy.
 * - Doctors can create DoctorPatient entries for patients, establishing a relationship.
 *
 * Denormalization for Authorization:
 * - DoctorPatient documents are created under `/doctors/{doctorId}/patients/{patientId}` to establish a direct relationship
 *   and enable efficient listing of a doctor's patients.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure root-level access.
     * @path /
     * @allow (get, list) if false
     * @deny (create, update, delete) always
     * @principle Prevents blanket access to the entire database.
     */
    match /{document=**} {
      allow read, write: if false;
    }

    /**
     * @description Manages user profile information.
     * @path /users/{userId}
     * @allow create: if isSignedIn() && request.auth.uid == userId;
     * @allow get: if isOwner(userId);
     * @allow list: if false;
     * @allow update: if isOwner(userId);
     * @allow delete: if isOwner(userId);
     * @deny create: if !isSignedIn() || request.auth.uid != userId;
     * @deny update: if !isOwner(userId);
     * @deny delete: if !isOwner(userId);
     * @principle Enforces user ownership and prevents unauthorized profile access.
     */
    match /users/{userId} {
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow get: if isOwner(userId);
      allow list: if false;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Secures patient data accessible only to the patient.
     * @path /users/{userId}/patients/{patientId}
     * @allow create: if isSignedIn() && request.auth.uid == userId && request.resource.data.id == patientId;
     * @allow get: if isOwner(userId);
     * @allow list: if isOwner(userId);
     * @allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
     * @allow delete: if isExistingOwner(userId);
     * @deny create: if !isSignedIn() || request.auth.uid != userId || request.resource.data.id != patientId;
     * @deny update: if !isExistingOwner(userId) || request.resource.data.id != resource.data.id;
     * @deny delete: if !isExistingOwner(userId);
     * @principle Enforces strict patient-only access to their data and validates data integrity.
     */
    match /users/{userId}/patients/{patientId} {
      allow create: if isSignedIn() && request.auth.uid == userId && request.resource.data.id == patientId;
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secures medical records under a patient's data.
     * @path /users/{userId}/patients/{patientId}/records/{recordId}
     * @allow create: if isSignedIn() && request.auth.uid == userId;
     * @allow get: if isOwner(userId);
     * @allow list: if isOwner(userId);
     * @allow update: if isExistingOwner(userId);
     * @allow delete: if isExistingOwner(userId);
     * @deny create: if !isSignedIn() || request.auth.uid != userId;
     * @deny update: if !isExistingOwner(userId);
     * @deny delete: if !isExistingOwner(userId);
     * @principle Enforces patient-only access to their medical records.
     */
    match /users/{userId}/patients/{patientId}/records/{recordId} {
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
    
    /**
     * @description Controls access to doctor profiles, which are publicly readable.
     * @path /doctors/{doctorId}
     * @allow get: if true;
     * @allow list: if true;
     * @allow create: if isSignedIn() && request.auth.uid == doctorId;
     * @allow update: if isExistingOwner(doctorId);
     * @allow delete: if isExistingOwner(doctorId);
     * @principle Allows public read access but restricts writes to the doctor.
     */
    match /doctors/{doctorId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.auth.uid == doctorId;
      allow update: if isExistingOwner(doctorId);
      allow delete: if isExistingOwner(doctorId);
    }

    /**
     * @description Manages the doctor-patient relationship.  Doctors can create/update these entries.
     * @path /doctors/{doctorId}/patients/{patientId}
     * @allow create: if isSignedIn();
     * @allow get: if true;
     * @allow list: if true;
     * @allow update: if isSignedIn();
     * @allow delete: if isSignedIn();
     * @principle Allows doctors to manage their patient lists.
     */
    match /doctors/{doctorId}/patients/{patientId} {
      allow create: if isSignedIn();
      allow get: if true;
      allow list: if true;
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Controls access to consultation requests.
     * @path /consultations/{consultationId}
     * @allow create: if isSignedIn();
     * @allow get: if true;
     * @allow list: if true;
     * @allow update: if isSignedIn();
     * @allow delete: if isSignedIn();
     */
    match /consultations/{consultationId} {
       allow create: if isSignedIn();
       allow get: if true;
       allow list: if true;
       allow update: if isSignedIn();
       allow delete: if isSignedIn();
    }
  }

  // Helper Functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return isSignedIn() && request.auth.uid == userId;
  }

    function isExistingOwner(userId) {
    return isOwner(userId) && resource != null;
  }
}