{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "type": "object",
      "description": "Represents a user's profile information.",
      "properties": {
        "role": {
          "type": "string",
          "enum": ["patient", "doctor"],
          "description": "The role of the user."
        }
      },
      "required": ["role"]
    },
    "Patient": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Patient",
      "type": "object",
      "description": "Represents a patient with their medical records and related information.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Patient entity."
        },
        "name": {
          "type": "string",
          "description": "The patient's full name."
        },
        "age": {
          "type": "number",
          "description": "The patient's age in years."
        },
        "gender": {
          "type": "string",
          "description": "The patient's gender."
        },
        "email": {
          "type": "string",
          "description": "The patient's email address.",
          "format": "email"
        }
      },
      "required": ["id", "name", "age", "gender", "email"]
    },
    "Record": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Record",
      "type": "object",
      "description": "Represents a medical record associated with a patient.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Record entity."
        },
        "patientId": {
          "type": "string",
          "description": "Reference to Patient. (Relationship: Patient 1:N Record)"
        },
        "date": {
          "type": "string",
          "description": "The date of the medical record.",
          "format": "date-time"
        },
        "type": {
          "type": "string",
          "description": "The type of medical record (e.g., Lab Report, Prescription)."
        },
        "status": {
          "type": "string",
          "description": "The processing status of the medical record (e.g., processing, completed)."
        },
        "summary": {
          "type": "string",
          "description": "A concise summary of the medical record."
        },
        "rawDocument": {
          "type": "string",
          "description": "The raw, unprocessed text of the medical document."
        }
      },
      "required": ["id", "patientId", "date", "type", "status", "summary", "rawDocument"]
    },
    "DoctorPatient": {
      "title": "Doctor's Patient",
      "type": "object",
      "description": "Represents the relationship between a doctor and a patient, with summary data for list views.",
      "properties": {
        "patientId": { "type": "string", "description": "The ID of the patient." },
        "name": { "type": "string" },
        "age": { "type": "number" },
        "gender": { "type": "string" },
        "recordCount": { "type": "number" }
      },
      "required": ["patientId", "name", "age", "gender", "recordCount"]
    },
    "Consultation": {
      "title": "Consultation",
      "type": "object",
      "description": "Represents a consultation request and its lifecycle.",
      "properties": {
        "patientId": { "type": "string" },
        "patientName": { "type": "string" },
        "patientAvatarUrl": { "type": "string" },
        "patientAge": { "type": "number" },
        "patientGender": { "type": "string" },
        "doctorId": { "type": "string" },
        "complaint": { "type": "string" },
        "urgency": { "type": "string", "enum": ["High", "Medium", "Low"] },
        "status": { "type": "string", "enum": ["pending", "accepted", "active", "completed", "declined"] },
        "requestedAt": { "type": "string", "format": "date-time" },
        "scheduledFor": { "type": "string", "format": "date-time" }
      },
      "required": ["patientId", "patientName", "doctorId", "complaint", "status", "requestedAt"]
    },
    "DoctorProfile": {
      "title": "Doctor Profile",
      "type": "object",
      "description": "Public-facing profile information for a doctor.",
      "properties": {
        "name": { "type": "string" },
        "photoUrl": { "type": "string" },
        "specialty": { "type": "string" },
        "location": { "type": "string" },
        "experience": { "type": "number" },
        "consultationFee": { "type": "number" },
        "education": { "type": "string" },
        "bio": { "type": "string" }
      },
      "required": ["name", "specialty", "location", "experience", "consultationFee", "education"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "schema": { "$ref": "#/backend/entities/UserProfile" },
          "description": "Stores user profile information, including their role."
        }
      },
      {
        "path": "/users/{userId}/patients/{patientId}",
        "definition": {
          "entityName": "Patient",
          "schema": { "$ref": "#/backend/entities/Patient" },
          "description": "Stores full patient data, only accessible by the patient themselves."
        }
      },
      {
        "path": "/users/{userId}/patients/{patientId}/records/{recordId}",
        "definition": {
          "entityName": "Record",
          "schema": { "$ref": "#/backend/entities/Record" },
          "description": "Stores medical records for a patient."
        }
      },
       {
        "path": "/doctors/{doctorId}",
        "definition": {
            "entityName": "DoctorProfile",
            "schema": { "$ref": "#/backend/entities/DoctorProfile" },
            "description": "Stores public-facing professional information for doctors."
        }
      },
      {
        "path": "/doctors/{doctorId}/patients/{patientId}",
        "definition": {
            "entityName": "DoctorPatient",
            "schema": { "$ref": "#/backend/entities/DoctorPatient" },
            "description": "A summary of a patient assigned to a doctor. Used for list views."
        }
      },
      {
        "path": "/consultations/{consultationId}",
        "definition": {
            "entityName": "Consultation",
            "schema": { "$ref": "#/backend/entities/Consultation" },
            "description": "Stores consultation requests and their status."
        }
      }
    ]
  }
}
